{
  "name": "@xrblocks/devtools",
  "version": "0.1.0",
  "description": "Developer tools for XR Blocks apps, sessions, agent runs, and visual previews.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "bin": {
    "xrblocks-devtools": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "!examples/**/artifacts",
    "!examples/**/node_modules",
    "docs",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build:xrblocks:sdk": "npm --prefix ../xrblocks run build:sdk",
    "link:xrblocks": "node scripts/link-xrblocks.mjs",
    "link:cli": "npm run build && npm link",
    "setup:local": "npm install && npm run build:xrblocks:sdk && npm run link:xrblocks",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "lint": "eslint src scripts test",
    "format": "npm run format:fix",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,mdx,ts,css}\" --check",
    "format:fix": "prettier \"**/*.{cjs,html,js,json,md,mdx,ts,css}\" --write",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples": "node scripts/serve-examples.mjs",
    "example:visualize:ui": "npm run build && node dist/cli.js visualize ui examples/previews/ui-card.preview.ts --xrblocks-root ../xrblocks -o examples/previews/artifacts/ui-card.png",
    "example:visualize:model": "npm run build && node dist/cli.js visualize model examples/previews/model-box.preview.ts -o examples/previews/artifacts/model-box.png",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.27.1",
    "playwright": "^1.61.0",
    "three": "^0.184.0"
  },
  "peerDependencies": {
    "tiny-tts": "^5.0.1",
    "xrblocks": "^0.20.0"
  },
  "peerDependenciesMeta": {
    "tiny-tts": {
      "optional": true
    },
    "xrblocks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/genai": "^2.7.0",
    "@eslint/js": "^9.35.0",
    "@pmndrs/uikit": "^1.0.64",
    "@preact/signals-core": "^1.14.0",
    "@types/node": "^25.0.0",
    "@types/three": "^0.184.0",
    "eslint": "^9.35.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^16.4.0",
    "lit": "^3.3.1",
    "prettier": "^3.6.2",
    "three-pathfinding": "^1.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.4",
    "vitest": "^4.0.0",
    "xrblocks": "git+https://github.com/whuang37/xrblocks.git#3eb2b2fc509f57628ad3b3f9c10cada8ccead413"
  }
}
